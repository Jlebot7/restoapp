{
  "rules": {
    "menu": {
      ".read": true,
      ".write": "auth != null",
      "$item_id": {
        ".validate": "newData.hasChildren(['name', 'price']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('price').isNumber() && newData.child('price').val() > 0"
      }
    }
  }
}
